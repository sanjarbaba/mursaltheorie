{
  "cleanUrls": true,
  "regions": [
    "fra1"
  ],
  "functions": {
    "api/v1/apple-purchases.js": {
      "maxDuration": 30,
      "includeFiles": "api/v1/apple-certs/*.cer"
    },
    "api/v1/google-purchases.js": {
      "maxDuration": 30
    },
    "api/**/*.js": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/pashto-content.js",
      "destination": "/api/v1/access?resource=pashto-content"
    },
    {
      "source": "/api/v1/results",
      "destination": "/api/v1/access?resource=results"
    }
  ],
  "redirects": [
    {
      "source": "/app",
      "destination": "/learn5?v=20260831-1432",
      "permanent": false
    },
    {
      "source": "/app.html",
      "destination": "/learn5?v=20260831-1432",
      "permanent": false
    },
    {
      "source": "/game",
      "destination": "/game/spelen",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/admin",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/admin-content.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/learn5",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/learn5.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/account-data.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosn"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/game/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/pashto-content.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/signs-part1.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    }
  ]
}
