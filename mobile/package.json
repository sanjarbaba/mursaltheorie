    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.1",
    "expo-iap": "3.4.13",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.18",
    "expo-secure-store": "~57.0.3",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.26.0"
  },
  "devDependencies": {
